// Prisma schema for improve. — Postgres backed user accounts.

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  // Bumped on logout so previously issued session tokens stop working.
  tokenVersion Int      @default(0)
  // Science stream: "cs" (Computer Science) or "biology" (Botany + Zoology).
  stream       String   @default("biology")
  // Set when the address is verified. Owned by the parallel
  // email-verification work — declared here so `db push` preserves it.
  emailVerified DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@map("users")

  progress ChapterProgress[]
  marks    PreviousMark[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens VerificationToken[]
}

// Single-use password-reset tokens. Only SHA-256 hashes are stored, so a
// DB leak alone can never redeem a token. Consuming = deleting the row,
// so no token can ever be used twice. Maps the pre-existing table.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Owned by the parallel email-verification work — declared here so
// `db push` never proposes to drop it. Not touched by the reset flow.
model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("verification_tokens")
}

// Per-user, per-chapter study progress (0–100).
model ChapterProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  chapter   String
  percent   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, subject, chapter])
  @@index([userId])
  @@index([updatedAt])
  @@map("chapter_progress")
}

// Last-exam marks per subject, private to each user. The server derives
// individual study priorities from these — never an overall grouped score.
model PreviousMark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  got       Int      @default(0)
  max       Int      @default(100)
  updatedAt DateTime @updatedAt

  @@unique([userId, subject])
  @@index([userId])
  @@map("previous_marks")
}
