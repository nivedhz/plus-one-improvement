// Prisma schema for improve. — Postgres backed user accounts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  // Bumped on logout so previously issued session tokens stop working.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("users")
}
